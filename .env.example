# Server
PORT=3001
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb://localhost:27017/florida-hoa-shield

# JWT
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=7d

# Client URL (for CORS)
CLIENT_URL=http://localhost:3000

# Server public URL (for payment email links)
SERVER_URL=http://localhost:3001

# Stripe — get keys from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...             # for /api/payments/webhook
STRIPE_SUBSCRIPTION_WEBHOOK_SECRET=whsec_... # for /api/subscription/webhook

# Gmail — for sending payment request/receipt emails
GMAIL_USER=your@gmail.com
GMAIL_APP_PASSWORD=your_app_password
