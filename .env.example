# ─────────────────────────────────────────────────────────
# Server  (set these on Railway / Render)
# ─────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=production

# ─────────────────────────────────────────────────────────
# MongoDB Atlas
# Create free cluster at https://cloud.mongodb.com
# Connection string looks like:
#   mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/florida-hoa-shield
# ─────────────────────────────────────────────────────────
MONGODB_URI=mongodb+srv://user:password@cluster0.xxxxx.mongodb.net/florida-hoa-shield

# ─────────────────────────────────────────────────────────
# JWT  — generate with: openssl rand -base64 48
# ─────────────────────────────────────────────────────────
JWT_SECRET=replace_with_long_random_secret
JWT_EXPIRES_IN=7d

# ─────────────────────────────────────────────────────────
# URLs
# CLIENT_URL = your Vercel frontend URL (comma-separate for multiple)
# SERVER_URL = your Railway/Render backend URL (used in payment email links)
# ─────────────────────────────────────────────────────────
CLIENT_URL=https://florida-hoa-shield.vercel.app
SERVER_URL=https://florida-hoa-shield-api.onrender.com

# ─────────────────────────────────────────────────────────
# Stripe — https://dashboard.stripe.com/apikeys
# Use sk_test_... while testing, sk_live_... for production
# ─────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_...

# Webhook secrets — from Stripe Dashboard → Developers → Webhooks
# Endpoint 1: https://florida-hoa-shield-api.onrender.com/api/payments/webhook
#   Events: checkout.session.completed
STRIPE_WEBHOOK_SECRET=whsec_...

# Endpoint 2: https://florida-hoa-shield-api.onrender.com/api/subscription/webhook
#   Events: checkout.session.completed, customer.subscription.updated,
#           customer.subscription.deleted, invoice.payment_failed
STRIPE_SUBSCRIPTION_WEBHOOK_SECRET=whsec_...

# ─────────────────────────────────────────────────────────
# Gmail  (for payment request / receipt emails)
# Enable 2FA → https://myaccount.google.com/apppasswords → generate password
# ─────────────────────────────────────────────────────────
GMAIL_USER=your@gmail.com
GMAIL_APP_PASSWORD=xxxx_xxxx_xxxx_xxxx

# ─────────────────────────────────────────────────────────
# React frontend  (set these on Vercel)
# ─────────────────────────────────────────────────────────
REACT_APP_API_URL=https://florida-hoa-shield-api.onrender.com/api
